{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cat-Codex-Switcher",
  "version": "0.2.0",
  "identifier": "com.cat.codex.switcher",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cat Codex Switcher",
        "width": 540,
        "height": 680,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app.ico",
      "icons/account-switcher-logo.png"
    ]
  }
}
